# Copy to .env and edit.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nexl
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables open-ended chat when no local skill can answer.
# ANTHROPIC_API_KEY=sk-ant-...
# NEXL_LLM_MODEL=claude-sonnet-5-5

# OpenRouter LLM fallback. Leave blank to run on local skills only.
OPENROUTER_API_KEY=
NEXL_LLM_MODEL=anthropic/claude-sonnet-5.5
