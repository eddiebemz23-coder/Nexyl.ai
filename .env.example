# Copy to .env and edit.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nexyl
JWT_SECRET=change-me-to-a-long-random-string

# LLM fallback for questions no local skill answers. Leave both keys blank to run on local
# skills only. When both are set, Gemini wins unless NEXYL_LLM_PROVIDER names the other one.
GEMINI_API_KEY=
NEXYL_LLM_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
NEXYL_OPENAI_MODEL=gpt-4.1-mini
# NEXYL_LLM_PROVIDER=openai

# Connection cap per process. Neon runs one pool per isolate, so keep it small there.
PG_POOL_MAX=10

# Deploying to Neon? The Function's environment is a separate, git-ignored file
# (.env.neon) written by `neon env pull` and `npm run neon:env`. Don't hand-edit it.
