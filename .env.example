# Copy to .env and edit.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nexyl
JWT_SECRET=change-me-to-a-long-random-string

# LLM fallback for questions no local skill answers. Leave every key blank to run on local
# skills only. Providers are tried in the order groq, gemini, openai, anthropic until one
# answers; NEXYL_LLM_PROVIDER pins a single one instead.
GEMINI_API_KEY=
NEXYL_LLM_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
NEXYL_OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
NEXYL_GROQ_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=
NEXYL_ANTHROPIC_MODEL=claude-sonnet-4-6
# NEXYL_LLM_PROVIDER=gemini

# Connection cap per process. Neon runs one pool per isolate, so keep it small there.
PG_POOL_MAX=10

# Deploying to Neon? The Function's environment is a separate, git-ignored file
# (.env.neon) written by `neon env pull` and `npm run neon:env`. Don't hand-edit it.
